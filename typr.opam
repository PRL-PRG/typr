# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Orchestrator of the TypR static type-checker for R"
description: """
Parses an R package (R sources and native C sources), resolves the
 dependencies between their functions, and drives Rsem and NativeSem
 accordingly."""
maintainer: ["Mickael Laurent" "Pierre Donat-Bouillud"]
authors: ["Mickael Laurent" "Pierre Donat-Bouillud"]
license: "MIT"
tags: ["R" "types" "C"]
homepage: "https://github.com/PRL-PRG/typr"
bug-reports: "https://github.com/PRL-PRG/typr/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.20"}
  "rsem"
  "r-c-typing"
  "rstt"
  "mlsem"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/PRL-PRG/typr.git"
x-maintenance-intent: ["(latest)"]
