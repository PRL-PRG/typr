; ===== Pipeline smoke test =====
; It must order the R files by dependency, type the C sources, and use the
; resulting types on the R side.
; The `.ty` files are NativeSem's; `typr/types` copies them, so that the
; R-C-API signatures are found from the build directory as well.
(rule
 (alias runtest)
 (deps
  (glob_files %{project_root}/types/*.ty)
  (source_tree packages/smallpkg))
 (action
  (with-stdout-to
   smallpkg.output
   (run %{exe:../bin/main.exe} packages/smallpkg))))

(rule
 (alias runtest)
 (deps packages/smallpkg.expected smallpkg.output)
 (action
  (diff packages/smallpkg.expected smallpkg.output)))

; ===== R packages =====
; Real CRAN packages (and one synthetic package of minimal reproductions),
; type-checked against the base R signatures of `prelude/base.R`. See
; ../docs/r-experiment-report.md for what each of them exercises.
(rule
 (alias runtest)
 (deps
  (glob_files %{project_root}/types/*.ty)
  prelude/base.R
  (source_tree packages/praise))
 (action
  (with-stdout-to
   praise.output
   (run %{exe:../bin/main.exe} --prelude prelude/base.R packages/praise))))

(rule
 (alias runtest)
 (deps packages/praise.expected praise.output)
 (action
  (diff packages/praise.expected praise.output)))

(rule
 (alias runtest)
 (deps
  (glob_files %{project_root}/types/*.ty)
  prelude/base.R
  (source_tree packages/rematch))
 (action
  (with-stdout-to
   rematch.output
   (run %{exe:../bin/main.exe} --prelude prelude/base.R packages/rematch))))

(rule
 (alias runtest)
 (deps packages/rematch.expected rematch.output)
 (action
  (diff packages/rematch.expected rematch.output)))

; The same package again with --gradual, which gives the names nothing binds
; the `dyn` type instead of reporting them: the domains still get inferred
; where the default run gives up entirely.
(rule
 (alias runtest)
 (deps
  (glob_files %{project_root}/types/*.ty)
  prelude/base.R
  (source_tree packages/rematch))
 (action
  (with-stdout-to
   rematch-gradual.output
   (run %{exe:../bin/main.exe} --gradual --prelude prelude/base.R packages/rematch))))

(rule
 (alias runtest)
 (deps packages/rematch-gradual.expected rematch-gradual.output)
 (action
  (diff packages/rematch-gradual.expected rematch-gradual.output)))

